{
  "name": "gabinete-plus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gabinete-plus/shared build && pnpm --parallel --filter @gabinete-plus/api --filter @gabinete-plus/mobile dev",
    "dev:api": "pnpm --filter @gabinete-plus/shared build && pnpm --filter @gabinete-plus/api dev",
    "dev:mobile": "pnpm --filter @gabinete-plus/shared build && pnpm --filter @gabinete-plus/mobile start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check": "pnpm --filter @gabinete-plus/shared build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:operations",
    "test:operations": "node --test scripts/db-transfer.test.mjs",
    "db:backup": "node --env-file=.env scripts/db-backup.mjs",
    "db:restore": "node --env-file=.env scripts/db-restore.mjs",
    "db:generate": "pnpm --filter @gabinete-plus/api prisma:generate",
    "db:migrate": "pnpm --filter @gabinete-plus/api prisma:migrate",
    "db:seed": "pnpm --filter @gabinete-plus/api seed",
    "docs:generate": "pnpm --filter @gabinete-plus/shared build && pnpm --filter @gabinete-plus/api docs:generate",
    "test:integration": "pnpm --filter @gabinete-plus/shared build && pnpm --filter @gabinete-plus/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
