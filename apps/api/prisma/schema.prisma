generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CHEFE
  ASSESSOR
  APOIO
}

enum UserPosition {
  MAGISTRADO_GESTOR
  ASSESSOR_CHEFE
  ASSESSOR
  APOIO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  positionHistory UserPositionHistory[]
  authSessions AuthSession[]
  createdRoutines Routine[] @relation("RoutineCreator")
  updatedRoutines Routine[] @relation("RoutineEditor")
  createdChecklistTemplates ChecklistTemplate[] @relation("ChecklistCreator")
  updatedChecklistTemplates ChecklistTemplate[] @relation("ChecklistEditor")
  createdChecklistRuns ChecklistRun[] @relation("RunCreator")
  assignedChecklistRuns ChecklistRun[] @relation("RunAssignee")
  completedChecklistItems ChecklistRunItem[] @relation("ItemCompleter")

  @@map("users")
}

model UserPositionHistory {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  position  UserPosition
  role      UserRole
  startedAt DateTime     @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
  @@map("user_position_history")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id         String      @id @default(uuid())
  sessionId  String
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash  String      @unique @db.Char(64)
  createdAt  DateTime    @default(now())
  consumedAt DateTime?

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum RoutineFrequency {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  EVENTUAL
  PERSONALIZADA
  A_DEFINIR
}

model Routine {
  id String @id @default(cuid())
  title String @db.VarChar(200)
  category String @db.VarChar(100)
  frequency RoutineFrequency
  description String @default("")
  instructions String @default("")
  steps String[] @default([])
  frequencyDetails String?
  specificDate DateTime? @db.Date
  defaultPosition UserPosition?
  essentialForTransition Boolean @default(false)
  isArchived Boolean @default(false)
  createdById String
  createdBy User @relation("RoutineCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy User @relation("RoutineEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistTemplates ChecklistTemplate[]
  checklistRuns ChecklistRun[]

  @@index([isArchived, id])
  @@index([frequency, isArchived, id])
  @@index([category, isArchived, id])
  @@map("routines")
}

enum ChecklistStatus {
  POR_FAZER
  EM_ANDAMENTO
  CONCLUIDA
}

model ChecklistTemplate {
  id String @id @default(cuid())
  routineId String
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Restrict)
  title String @db.VarChar(200)
  items String[]
  version Int @default(1)
  isArchived Boolean @default(false)
  createdById String
  createdBy User @relation("ChecklistCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy User @relation("ChecklistEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs ChecklistRun[]

  @@index([routineId, isArchived, id])
  @@map("checklist_templates")
}

model ChecklistRun {
  id String @id @default(cuid())
  templateId String
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  routineId String
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Restrict)
  assigneeId String
  assignee User @relation("RunAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById String
  createdBy User @relation("RunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  titleSnapshot String
  routineTitleSnapshot String
  instructionsSnapshot String
  frequencySnapshot RoutineFrequency
  templateVersion Int
  periodKey String @db.VarChar(40)
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  status ChecklistStatus @default(POR_FAZER)
  totalItems Int
  completedItems Int @default(0)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items ChecklistRunItem[]

  @@unique([templateId, periodKey])
  @@index([assigneeId, periodStart, id])
  @@index([routineId, periodStart, id])
  @@map("checklist_runs")
}

model ChecklistRunItem {
  id String @id @default(cuid())
  runId String
  run ChecklistRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  position Int
  text String
  isCompleted Boolean @default(false)
  completedById String?
  completedBy User? @relation("ItemCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  completedAt DateTime?

  @@unique([runId, position])
  @@map("checklist_run_items")
}
