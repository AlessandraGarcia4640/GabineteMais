{
  "name": "@gabinete-plus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma.config.ts vitest.integration.config.ts --max-warnings=0",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "docs:generate": "tsx src/documentation/generate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@gabinete-plus/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "8.3.0",
    "jose": "^6.1.0",
    "pg": "8.22.0",
    "swagger-ui-dist": "5.33.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10",
    "@types/swagger-ui-dist": "3.30.6",
    "@apidevtools/swagger-parser": "12.1.0"
  }
}
